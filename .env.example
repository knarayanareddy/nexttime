# Safe local examples only. Owners: API, local Bee bridge, minimization, and rehearsal services.
APP_ENV=local
AWS_REGION=us-east-1
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEMO_MODE=fixture
DATA_RETENTION_DAYS=1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
BEDROCK_MODEL_ID=
PROMPT_SET_VERSION=
RUBRIC_VERSION=rubric_v1
# Official Bee CLI/MCP command names must be verified before live configuration; local_spool is fixture-only.
BEE_ADAPTER=disabled
BEE_CLI_PATH=
BEE_SPOOL_DIR=
BEE_MCP_ENDPOINT=
