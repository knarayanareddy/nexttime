# Safe local examples only. Owners: future API, bridge, ingestion, and rehearsal workers.
APP_ENV=local
AWS_REGION=us-east-1
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DEMO_MODE=fixture
DATA_RETENTION_DAYS=1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
BEDROCK_MODEL_ID=
PROMPT_SET_VERSION=
RUBRIC_VERSION=rubric_v1
# The official Bee command/tool names must be verified before an adapter is configured.
BEE_ADAPTER=disabled
BEE_CLI_PATH=
BEE_MCP_ENDPOINT=
