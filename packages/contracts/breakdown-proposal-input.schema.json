{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.local/nexttime/breakdown-proposal-input.schema.json",
  "title": "NextTime Breakdown Proposal Gateway Input",
  "description": "Bounded self-only input contract for proposing functional breakdowns and rubric criterion candidates. Raw other-speaker turns are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "situation",
    "capture_mode",
    "rubric_version",
    "required_criteria",
    "optional_criteria",
    "asr_confidence",
    "other_speaker_transcript_retained",
    "self_excerpts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "situation": {
      "enum": [
        "repair_appointment",
        "school_admin_appointment",
        "shift_clarification"
      ]
    },
    "capture_mode": {
      "enum": ["consented_conversation", "self_memo"]
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^rubric_v[0-9]+$"
    },
    "required_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/criterion_id" }
    },
    "optional_criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/criterion_id" }
    },
    "asr_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "other_speaker_transcript_retained": { "const": false },
    "self_excerpts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["excerpt_index", "text", "start_ms", "end_ms", "confidence"],
        "properties": {
          "excerpt_index": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "criterion_id": {
      "enum": [
        "goal_stated",
        "repair_requested",
        "details_understood",
        "appointment_confirmed",
        "next_step_confirmed",
        "independent_completion"
      ]
    }
  }
}
