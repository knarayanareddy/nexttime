{
  "meta": {
    "project": "NextTime",
    "version": "1.0.0",
    "platforms": ["ios", "accessibility_text_sizes"],
    "theme": "light_quiet_pocket_coach",
    "contrast_pairs": {
      "text_on_canvas": { "foreground": "color.text", "background": "color.canvas", "minimum": 4.5 },
      "muted_on_canvas": { "foreground": "color.text_muted", "background": "color.canvas", "minimum": 4.5 },
      "text_on_surface": { "foreground": "color.text", "background": "color.surface", "minimum": 4.5 },
      "muted_on_surface": { "foreground": "color.text_muted", "background": "color.surface", "minimum": 4.5 },
      "primary_button": { "foreground": "color.on_primary", "background": "color.primary", "minimum": 4.5 },
      "accent_button": { "foreground": "color.on_accent", "background": "color.accent", "minimum": 4.5 },
      "focus_on_canvas": { "foreground": "color.focus", "background": "color.canvas", "minimum": 3.0 },
      "success_on_surface": { "foreground": "color.success", "background": "color.surface", "minimum": 4.5 },
      "warning_on_surface": { "foreground": "color.warning", "background": "color.surface", "minimum": 4.5 },
      "danger_on_surface": { "foreground": "color.danger", "background": "color.surface", "minimum": 4.5 }
    }
  },
  "color": {
    "canvas": { "$type": "color", "$value": "#F6F2EB" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "surface_alt": { "$type": "color", "$value": "#E8EEE9" },
    "text": { "$type": "color", "$value": "#23332F" },
    "text_muted": { "$type": "color", "$value": "#53645D" },
    "primary": { "$type": "color", "$value": "#2F6255" },
    "on_primary": { "$type": "color", "$value": "#FFFFFF" },
    "accent": { "$type": "color", "$value": "#91492F" },
    "on_accent": { "$type": "color", "$value": "#FFFFFF" },
    "border": { "$type": "color", "$value": "#B7C4BC" },
    "focus": { "$type": "color", "$value": "#285F8F" },
    "success": { "$type": "color", "$value": "#2E684D" },
    "warning": { "$type": "color", "$value": "#735000" },
    "danger": { "$type": "color", "$value": "#91343B" },
    "info": { "$type": "color", "$value": "#315F8C" }
  },
  "typography": {
    "display": { "$type": "fontFamily", "$value": "SF Pro Display, system-ui, sans-serif" },
    "body": { "$type": "fontFamily", "$value": "SF Pro Text, system-ui, sans-serif" },
    "data": { "$type": "fontFamily", "$value": "SF Pro Text, system-ui, sans-serif" },
    "size_display": { "$type": "dimension", "$value": "34pt" },
    "size_title": { "$type": "dimension", "$value": "22pt" },
    "size_body": { "$type": "dimension", "$value": "17pt" },
    "size_small": { "$type": "dimension", "$value": "15pt" },
    "line_body": { "$type": "number", "$value": 1.45 }
  },
  "spacing": {
    "unit": { "$type": "dimension", "$value": "4pt" },
    "page": { "$type": "dimension", "$value": "20pt" },
    "section": { "$type": "dimension", "$value": "28pt" },
    "control": { "$type": "dimension", "$value": "12pt" }
  },
  "shape": {
    "radius_small": { "$type": "dimension", "$value": "10px" },
    "radius_large": { "$type": "dimension", "$value": "18px" },
    "target_minimum": { "$type": "dimension", "$value": "44pt" },
    "focus_width": { "$type": "dimension", "$value": "3px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "200ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0.0, 0.0, 1.0] }
  },
  "layout": {
    "content_max": { "$type": "dimension", "$value": "680px" },
    "reading_max": { "$type": "dimension", "$value": "46ch" },
    "recording_control": { "$type": "dimension", "$value": "88pt" }
  }
}
